# RepoMind Environment Configuration

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Directory paths (defaults to local workspace)
# DATA_DIR=./.repomind_data
# SAMPLES_DIR=./samples

# Active default repository
DEFAULT_REPO_ID=ecommerce_sample

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=phi3

# Security & Ingestion limits
MAX_FILE_SIZE_BYTES=2097152
MAX_REPO_FILES=2000
GIT_CLONE_TIMEOUT_SECONDS=60
