# RepoMind configuration. Copy to .env (never commit .env).
# Full list: docs/DEPLOYMENT.md

# LLM: set a Groq key (free at https://console.groq.com) ...
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ... or use a local Ollama model (used when no Groq key is set)
# OLLAMA_URL=http://localhost:11434
# DEFAULT_OLLAMA_MODEL=phi3

# Repo selected on startup
# DEFAULT_REPO_ID=ecommerce_sample

# Public server mode (disables local folders, rate-limits GitHub clones)
# PUBLIC_MODE=false
# GITHUB_ADDS_PER_HOUR=5

# Ingestion limits
# MAX_FILE_SIZE_BYTES=2097152
# MAX_REPO_FILES=2000
# GIT_CLONE_TIMEOUT_SECONDS=60
